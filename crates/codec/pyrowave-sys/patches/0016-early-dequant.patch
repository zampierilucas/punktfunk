+uint32_t Decoder::Impl::early_claim(uint32_t tag)
+{
+	any_claimed = true;
+	claimed_tag = tag;
+	early_use = early_slot >= 0 && early_tag == tag;
+	if (early_slot >= 0 && int32_t(early_tag - tag) < 0)
+		early_slot = -1;
+	return early_use ? early_done_blocks : 0;
+}
